# Semua permintaan diarahkan ke public/. Folder lain tidak pernah menjadi URL.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>
