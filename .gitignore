# --- Konfigurasi & rahasia ---
.env
.env.*
storage/credentials-*.txt
*.pem
*.key
*.crt
*.pfx
*.p12

# --- Data runtime (isi dilacak hanya .gitkeep) ---
storage/logs/*
storage/sessions/*
storage/cache/*
storage/backups/*
!storage/**/.gitkeep

# --- Data anggota & keuangan (sumber Excel, hasil ekstraksi, dump DB) ---
database/import/*.json
*.xlsx
*.xls
*.xlsm
*.csv
*.sql.gz
*.sql.sha256
*.sha256
*.dump
*.bak

# --- Berkas lokal / sensitif ---
.claude/
# Dokumen internal: memuat nama anggota, saldo, dan prosedur operasional
docs/

# --- Dependensi & hasil build ---
/node_modules/
/vendor/
__pycache__/
*.pyc

# --- Editor & sistem operasi ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
